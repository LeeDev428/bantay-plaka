SECRET_KEY=your-secret-key-here
DEBUG=True

DB_NAME=bantay_plaka
DB_USER=root
DB_PASSWORD=your_password
DB_HOST=127.0.0.1
DB_PORT=3306

# API key for the ANPR engine -- must match the key set in anpr_engine.py
ANPR_API_KEY=your-anpr-api-key-here

# Railway media storage (configure these as Railway service variables, not in source control).
# Railway production defaults USE_CLOUDINARY to True; uploads require all three Cloudinary
# credentials. Resident IDs and vehicle documents are stored as authenticated Cloudinary assets.
# USE_CLOUDINARY=True
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Railway Hobby blocks outbound SMTP. Use Resend's HTTPS API for password-reset email:
# EMAIL_BACKEND=apps.core.email_backend.ResendEmailBackend
# RESEND_API_KEY=re_your_resend_api_key
# DEFAULT_FROM_EMAIL=BantayPlaka <noreply@your-verified-domain.com>

# On the camera-worker machine, point this to the Railway application:
# ANPR_INGEST_URL=https://your-app.up.railway.app/detection/ingest/
# Live preview update interval (0.125 seconds is about 8 FPS; lower values increase upload traffic).
ANPR_HEARTBEAT_SECONDS=0.125

# Roboflow API key -- get from: Roboflow -> your profile -> Settings -> API Keys
ROBOFLOW_API_KEY=your-roboflow-api-key-here

# Roboflow model ID: project-slug/version
ROBOFLOW_MODEL_ID=plate-number-detection/5
